{
  "name": "mystery-stock-market",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "preview": "vite build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run test:engine && npm run test:worker",
    "test:engine": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.workers.config.ts",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && vite build && npm run test:e2e && node scripts/third-party.mjs --check && node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=24"
  }
}
