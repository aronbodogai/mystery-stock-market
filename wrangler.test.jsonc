// Config used only by the Durable Object tests (no custom domain, no assets).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mystery-stock-market-test",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-23",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "TV_PAIRING", "class_name": "TvPairing" },
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "TvPairing"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
  ],
  "vars": { "PUBLIC_ORIGIN": "https://stocks.test" }
}
