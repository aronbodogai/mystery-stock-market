// Config used only by the Durable Object tests (no custom domain, no assets).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mystery-stock-market-test",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "TV_PAIRING", "class_name": "TvPairing" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "TvPairing"] }],
  // Per-client limits (NFR-SEC-7): built-in Rate Limiting, one-minute windows, approximate per location.
  "ratelimits": [
    { "name": "RL_CREATE_ROOM", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_CREATE_TV", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_CONNECT", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": { "PUBLIC_ORIGIN": "https://stocks.test", "MCP_DEV_LOGIN": "1" }
}
